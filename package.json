{
  "name": "sniffnotes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:fragrances": "node --no-warnings scripts/import-fragrances.mts",
    "db:push": "sh scripts/supabase-remote.sh db push",
    "db:types": "sh scripts/supabase-remote.sh gen types typescript --schema public > lib/supabase/database.types.ts",
    "fetch:perfumapi": "node --no-warnings --env-file-if-exists=.env.local scripts/fetch-perfumapi.mts",
    "demo:seed": "node --no-warnings --env-file-if-exists=.env.local scripts/demo.mts seed",
    "demo:clear": "node --no-warnings --env-file-if-exists=.env.local scripts/demo.mts clear",
    "news:refresh": "node --no-warnings --env-file-if-exists=.env.local scripts/news-refresh.mts",
    "guide:fetch": "node --no-warnings scripts/guide.mts fetch",
    "guide:import": "node --no-warnings scripts/guide.mts import",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --no-warnings --test \"tests/*.test.mts\"",
    "check:data": "npm run import:fragrances && npm run guide:import && git diff --exit-code -- data/"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
