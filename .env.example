# Copy to .env.local and fill in from Supabase → Project Settings → API / Database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: used by the Supabase CLI to push migrations.
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=

# Server-only: Supabase secret key (Project Settings → API Keys). Used for account deletion.
SUPABASE_SECRET_KEY=

# Local PerfumAPI deployment the fragrance data is scraped from.
PERFUMAPI_URL=http://localhost:9000
SCRAPER_API_KEY=

# Server-only: protects /api/cron/news (any long random string; Vercel Cron sends it automatically).
CRON_SECRET=
